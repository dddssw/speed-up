{
  "name": "speed-up",
  "displayName": "speed up",
  "description": "speed up your import and commment code  ",
  "version": "0.0.6",
  "publisher": "dddssw",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.54.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsWelcome": [
      {
        "view": "hooks",
        "contents": "似乎没有解析出任何内容,你可以尝试修改解析路径\n[Open setting](command:speed-up.openHookPathSetting)\n抱歉,可能在解析时出现bug,你可以\n[Report bug](https://github.com/dddssw/speed-up)"
      },
      {
        "view": "utils",
        "contents": "似乎没有解析出任何内容,你可以尝试修改解析路径\n[Open setting](command:speed-up.openUtilPathSetting)\n抱歉,可能在解析时出现bug,你可以\n[Report bug](https://github.com/dddssw/speed-up)"
      }
    ],
    "commands": [
      {
        "command": "speed-up.openFile",
        "title": "Open File"
      },
      {
        "command": "speed-up.openFileAndScroll",
        "title": "Open File With Scroll"
      },
      {
        "command": "speed-up.importUtil",
        "title": "导入工具方法",
        "icon": "resources/dark/import.png"
      },
      {
        "command": "speed-up.importHook",
        "title": "全部导入hooks中return的部分",
        "icon": "resources/dark/import.png"
      },
      {
        "command": "speed-up.importHookPart",
        "title": "部分导入hooks中return的部分",
        "icon": "resources/dark/importPart.png"
      },
      {
        "command": "speed-up.replaceEditContent",
        "title": "替换当前编辑器文本内容"
      },
      {
        "command": "speed-up.addEditContent",
        "title": "添加当前编辑器文本内容"
      },
      {
        "command": "speed-up.refreshHooks",
        "title": "refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "speed-up.refreshUtils",
        "title": "refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "speed-up.login",
        "title": "login",
        "icon": "$(account)"
      },
      {
        "command": "speed-up.logout",
        "title": "logout",
        "icon": "$(close)"
      },
      {
        "command": "speed-up.element-plus",
        "title": "active element-plus termine"
      },
      {
        "command": "speed-up.insert-element-plus",
        "title": "插入element-plus组件模板"
      },
      {
        "command": "speed-up.openMySetting",
        "title": "open setting"
      },
      {
        "command": "speed-up.openHookPathSetting",
        "title": "打开解析hooks的路径配置"
      },
      {
        "command": "speed-up.openUtilPathSetting",
        "title": "打开解析utils的路径配置"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "speed-up.insert-element-plus",
          "when": "editorTextFocus && editorLangId == 'vue'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "speed-up.refreshHooks",
          "when": "view == hooks ",
          "group": "navigation"
        },
        {
          "command": "speed-up.refreshUtils",
          "when": "view == utils ",
          "group": "navigation"
        },
        {
          "command": "speed-up.login",
          "when": "view == utils || view == hooks",
          "group": "navigation"
        },
        {
          "command": "speed-up.logout",
          "when": "(view == utils || view == hooks) && speed-up.speepUpWebview",
          "group": "navigation"
        },
        {
          "when": "view == utils || view == hooks",
          "command": "speed-up.openMySetting",
          "group": "one"
        }
      ],
      "view/item/context": [
        {
          "command": "speed-up.importUtil",
          "when": "view == utils && viewItem == utilsImport",
          "group": "inline"
        },
        {
          "command": "speed-up.importHook",
          "when": "view == hooks && viewItem == hooksImport",
          "group": "inline"
        },
        {
          "command": "speed-up.importHookPart",
          "when": "view == hooks && viewItem == hooksImport",
          "group": "inline"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "hooks",
          "name": "hooks"
        },
        {
          "id": "utils",
          "name": "utils"
        }
      ]
    },
    "configuration": [
      {
        "title": "Speed Import",
        "properties": {
          "speedImport.hooksPath": {
            "type": "string",
            "default": "src/hooks",
            "description": "hooks路径"
          },
          "speedImport.hooksAliasPath": {
            "type": "string",
            "default": "@/hooks",
            "description": "hooks路径别名"
          },
          "speedImport.utilsPath": {
            "type": "string",
            "default": "src/utils",
            "description": "工具函数路径"
          },
          "speedImport.utilsAliasPath": {
            "type": "string",
            "default": "@/utils",
            "description": "工具函数路径别名"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.7",
    "@types/node": "^20.16.9",
    "@types/vscode": "^1.54.0",
    "@typescript-eslint/eslint-plugin": "^8.3.0",
    "@typescript-eslint/parser": "^8.3.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.4.1",
    "eslint": "^9.9.1",
    "ts-loader": "^9.5.1",
    "typescript": "^5.5.4",
    "webpack": "^5.94.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "exportinfo": "^1.1.2",
    "html-modifier": "^1.2.0",
    "zustand": "^5.0.2"
  }
}
